<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="StandUP.Views.Pages.GeneralPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:StandUP.Controls"
    Background="Transparent">

    <ScrollViewer>
        <StackPanel MaxWidth="{StaticResource PageMaxWidth}" Padding="{StaticResource PagePadding}">

            <TextBlock Text="{c:L Key=nav.general}" Style="{StaticResource PageTitleStyle}" />

            <TextBlock Text="{c:L Key=general.appearance}" Style="{StaticResource SectionHeaderStyle}" Margin="2,0,0,8" />
            <c:SettingsCard Glyph="&#xE790;" Header="{c:L Key=general.theme}" Description="{c:L Key=general.themeDesc}">
                <ComboBox x:Name="ThemeBox" MinWidth="200" SelectionChanged="OnThemeChanged" />
            </c:SettingsCard>
            <c:SettingsCard Glyph="&#xE771;" Header="{c:L Key=general.backdrop}" Description="{c:L Key=general.backdropDesc}">
                <ComboBox x:Name="BackdropBox" MinWidth="200" SelectionChanged="OnBackdropChanged" />
            </c:SettingsCard>
            <c:SettingsCard Glyph="&#xF2B7;" Header="{c:L Key=general.language}" Description="{c:L Key=general.languageDesc}">
                <ComboBox x:Name="LanguageBox" MinWidth="200" SelectionChanged="OnLanguageChanged" />
            </c:SettingsCard>

            <TextBlock Text="{c:L Key=general.startup}" Style="{StaticResource SectionHeaderStyle}" />
            <c:SettingsCard Glyph="&#xE770;" Header="{c:L Key=general.autostart}" Description="{c:L Key=general.autostartDesc}">
                <ToggleSwitch x:Name="AutoStartSwitch" OnContent="" OffContent="" MinWidth="0" Toggled="OnAutoStartToggled" />
            </c:SettingsCard>

            <TextBlock Text="{c:L Key=general.about}" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource CardBorderStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image x:Name="AboutIcon" Width="48" Height="48" VerticalAlignment="Top" />
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Text="StandUP" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock x:Name="VersionText" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{c:L Key=general.aboutDesc}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        <HyperlinkButton Content="{c:L Key=general.dataFolder}" Click="OnOpenDataFolderClick" Margin="-12,4,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <c:SettingsCard Glyph="&#xE7E8;" Header="{c:L Key=btn.exit}" Description="{c:L Key=general.exitDesc}" Margin="0,12,0,0">
                <Button Click="OnExitClick" Content="{c:L Key=dialog.exit}" MinWidth="120" />
            </c:SettingsCard>
        </StackPanel>
    </ScrollViewer>
</Page>
