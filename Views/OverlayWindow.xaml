<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="StandUP.Views.OverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:StandUP.Controls">

    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root" Background="#E6070B16" RequestedTheme="Dark">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.Resources>
            <!-- Content entrance: fade in while settling upward on the Fluent decelerate curve. -->
            <Storyboard x:Name="EntranceStoryboard">
                <DoubleAnimation Storyboard.TargetName="ContentPanel" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3" />
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ContentTransform" Storyboard.TargetProperty="TranslateY">
                    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="28" />
                    <SplineDoubleKeyFrame KeyTime="0:0:0.6" Value="0" KeySpline="0.1,0.9 0.2,1" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.9" />
            </Storyboard>

            <Storyboard x:Name="ExitStoryboard">
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ContentPanel" Storyboard.TargetProperty="Opacity">
                    <SplineDoubleKeyFrame KeyTime="0:0:0.18" Value="0" KeySpline="0.7,0 1,0.5" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ContentTransform" Storyboard.TargetProperty="TranslateY">
                    <SplineDoubleKeyFrame KeyTime="0:0:0.18" Value="-12" KeySpline="0.7,0 1,0.5" />
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>

            <!--
                Slow drift of the background light orbs. Each axis repeats on its own period; a shared
                storyboard-level AutoReverse would freeze the shorter axes until the longest one finished.
            -->
            <Storyboard x:Name="DriftStoryboard">
                <DoubleAnimation Storyboard.TargetName="OrbATransform" Storyboard.TargetProperty="TranslateX" From="-60" To="80" Duration="0:0:14" AutoReverse="True" RepeatBehavior="Forever">
                    <DoubleAnimation.EasingFunction>
                        <SineEase EasingMode="EaseInOut" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="OrbATransform" Storyboard.TargetProperty="TranslateY" From="-40" To="60" Duration="0:0:11" AutoReverse="True" RepeatBehavior="Forever">
                    <DoubleAnimation.EasingFunction>
                        <SineEase EasingMode="EaseInOut" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="OrbBTransform" Storyboard.TargetProperty="TranslateX" From="70" To="-90" Duration="0:0:16" AutoReverse="True" RepeatBehavior="Forever">
                    <DoubleAnimation.EasingFunction>
                        <SineEase EasingMode="EaseInOut" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="OrbBTransform" Storyboard.TargetProperty="TranslateY" From="50" To="-50" Duration="0:0:13" AutoReverse="True" RepeatBehavior="Forever">
                    <DoubleAnimation.EasingFunction>
                        <SineEase EasingMode="EaseInOut" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>
        </Grid.Resources>

        <Grid x:Name="Glow" Grid.RowSpan="3" Opacity="0" IsHitTestVisible="False">
            <Border x:Name="GlowWash" />
            <Ellipse x:Name="OrbA" Width="900" Height="900" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-280,-360,0,0">
                <Ellipse.RenderTransform>
                    <CompositeTransform x:Name="OrbATransform" />
                </Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse x:Name="OrbB" Width="1100" Height="1100" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-360,-480">
                <Ellipse.RenderTransform>
                    <CompositeTransform x:Name="OrbBTransform" />
                </Ellipse.RenderTransform>
            </Ellipse>
        </Grid>

        <!-- Top bar: brand on the left, clock on the right. -->
        <Grid x:Name="TopBar" VerticalAlignment="Top" Padding="48,28">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Image x:Name="BrandIcon" Width="28" Height="28" />
                <TextBlock Text="StandUP" FontSize="20" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" />
                <Border x:Name="PreviewChip" Visibility="Collapsed" Padding="10,3" CornerRadius="10" Background="#33FFFFFF" VerticalAlignment="Center" Margin="8,0,0,0">
                    <TextBlock x:Name="PreviewChipText" FontSize="12" Foreground="White" />
                </Border>
            </StackPanel>
            <TextBlock
                x:Name="ClockText"
                HorizontalAlignment="Right"
                FontFamily="Segoe UI Variable Display"
                FontSize="30"
                FontWeight="Light"
                Foreground="#DDFFFFFF" />
        </Grid>

        <ScrollViewer x:Name="ContentScroll" Grid.Row="1" Padding="40,20" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Center">
        <StackPanel
            x:Name="ContentPanel"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="18"
            Opacity="0"
            RenderTransformOrigin="0.5,0.5">
            <StackPanel.RenderTransform>
                <CompositeTransform x:Name="ContentTransform" />
            </StackPanel.RenderTransform>

            <Grid x:Name="MascotStage" Width="220" Height="220" HorizontalAlignment="Center" Margin="0,0,0,12">
                <c:PulseRings x:Name="Pulse" />
                <c:StandupMascot x:Name="ReminderMascot" />
            </Grid>

            <Border
                x:Name="Chip"
                HorizontalAlignment="Center"
                Padding="14,5"
                CornerRadius="14"
                Background="#1FFFFFFF"
                BorderBrush="#33FFFFFF"
                BorderThickness="1">
                <TextBlock x:Name="ChipText" FontSize="14" Foreground="#E6FFFFFF" />
            </Border>

            <TextBlock
                x:Name="TitleText"
                FontFamily="Segoe UI Variable Display"
                FontSize="56"
                FontWeight="SemiBold"
                Foreground="White"
                TextAlignment="Center"
                TextWrapping="Wrap"
                MaxWidth="1100"
                HorizontalAlignment="Center" />
            <TextBlock
                x:Name="SubtitleText"
                FontSize="22"
                LineHeight="34"
                Foreground="#C8FFFFFF"
                TextAlignment="Center"
                TextWrapping="Wrap"
                MaxWidth="820"
                HorizontalAlignment="Center" />

            <StackPanel
                x:Name="ActionPanel"
                Orientation="Horizontal"
                Spacing="16"
                Margin="0,14,0,0"
                HorizontalAlignment="Center">
                <Button
                    x:Name="PrimaryButton"
                    Style="{StaticResource AccentButtonStyle}"
                    FontSize="20"
                    FontWeight="SemiBold"
                    Padding="44,16"
                    MinWidth="220"
                    CornerRadius="30"
                    Click="OnPrimaryClick">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE73E;" FontSize="18" />
                        <TextBlock x:Name="PrimaryText" />
                    </StackPanel>
                </Button>
                <Button
                    x:Name="SecondaryButton"
                    FontSize="20"
                    Padding="40,16"
                    CornerRadius="30"
                    Click="OnSecondaryClick">
                    <Button.Resources>
                        <SolidColorBrush x:Key="ButtonBackground" Color="#1FFFFFFF" />
                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#33FFFFFF" />
                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#14FFFFFF" />
                        <SolidColorBrush x:Key="ButtonBorderBrush" Color="#40FFFFFF" />
                        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#66FFFFFF" />
                        <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#33FFFFFF" />
                        <SolidColorBrush x:Key="ButtonForeground" Color="White" />
                        <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White" />
                        <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#CCFFFFFF" />
                    </Button.Resources>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE916;" FontSize="18" />
                        <TextBlock x:Name="SecondaryText" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>
        </ScrollViewer>

        <StackPanel
            x:Name="FooterPanel"
            Grid.Row="2"
            VerticalAlignment="Bottom"
            HorizontalAlignment="Center"
            Orientation="Horizontal"
            Spacing="8"
            Margin="24,16,24,24">
            <FontIcon Glyph="&#xE72E;" FontSize="14" Foreground="#99FFFFFF" />
            <TextBlock x:Name="HintText" FontSize="14" Foreground="#99FFFFFF" TextWrapping="Wrap" MaxWidth="720" />
        </StackPanel>
    </Grid>
</Window>
