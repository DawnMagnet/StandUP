<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="StandUP.Views.OverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>

    <Grid Background="#D90B1220">
        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="20">
            <FontIcon
                x:Name="IconGlyph"
                FontSize="96"
                Foreground="#FF4CC2FF"
                HorizontalAlignment="Center" />
            <TextBlock
                x:Name="TitleText"
                FontSize="56"
                FontWeight="SemiBold"
                Foreground="White"
                HorizontalAlignment="Center" />
            <TextBlock
                x:Name="SubtitleText"
                FontSize="24"
                Foreground="#FFD0D6E0"
                TextAlignment="Center"
                TextWrapping="Wrap"
                MaxWidth="900"
                HorizontalAlignment="Center" />
            <StackPanel
                Orientation="Horizontal"
                Spacing="16"
                Margin="0,24,0,0"
                HorizontalAlignment="Center">
                <Button
                    x:Name="PrimaryButton"
                    Style="{StaticResource AccentButtonStyle}"
                    FontSize="22"
                    Padding="40,14"
                    Click="OnPrimaryClick" />
                <Button
                    x:Name="SecondaryButton"
                    FontSize="22"
                    Padding="40,14"
                    Click="OnSecondaryClick" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
