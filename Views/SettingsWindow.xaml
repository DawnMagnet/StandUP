<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="StandUP.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar">
            <TextBlock
                Text="StandUP"
                VerticalAlignment="Center"
                Margin="16,0,0,0"
                Style="{StaticResource CaptionTextBlockStyle}" />
        </Grid>

        <ScrollViewer Grid.Row="1">
            <StackPanel Padding="28,4,28,28" Spacing="16">

                <Border
                    Padding="20"
                    CornerRadius="8"
                    BorderThickness="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="StatusText" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                        <TextBlock x:Name="CountdownText" Style="{StaticResource TitleLargeTextBlockStyle}" />
                        <ProgressBar x:Name="PhaseProgress" Minimum="0" Maximum="1" />
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                            <Button x:Name="BreakNowButton" Click="OnBreakNowClick" />
                            <Button x:Name="RestartButton" Click="OnRestartClick" />
                            <Button x:Name="PauseButton" Click="OnPauseClick" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="TimeHeader" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,8,0,0" />

                <NumberBox
                    x:Name="SitBox"
                    Minimum="1" Maximum="480"
                    SmallChange="5" LargeChange="10"
                    SpinButtonPlacementMode="Inline"
                    ValueChanged="OnSitChanged" />
                <NumberBox
                    x:Name="StandBox"
                    Minimum="1" Maximum="240"
                    SmallChange="1" LargeChange="5"
                    SpinButtonPlacementMode="Inline"
                    ValueChanged="OnStandChanged" />
                <NumberBox
                    x:Name="SnoozeBox"
                    Minimum="1" Maximum="60"
                    SmallChange="1" LargeChange="5"
                    SpinButtonPlacementMode="Inline"
                    ValueChanged="OnSnoozeChanged" />

                <ToggleSwitch x:Name="SnoozeSwitch" Toggled="OnSnoozeToggled" />
                <ToggleSwitch x:Name="AutoStartSwitch" Toggled="OnAutoStartToggled" />

                <ComboBox
                    x:Name="LanguageBox"
                    MinWidth="220"
                    SelectionChanged="OnLanguageChanged" />

                <Expander
                    x:Name="CustomExpander"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="12">
                        <TextBlock
                            x:Name="CustomHint"
                            TextWrapping="Wrap"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                        <TextBlock x:Name="StandGroupText" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBox x:Name="StandTitleBox" />
                        <TextBox x:Name="StandMessageBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" />
                        <TextBox x:Name="StandConfirmBox" />
                        <TextBox x:Name="StandSnoozeBox" />

                        <TextBlock x:Name="SitGroupText" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,8,0,0" />
                        <TextBox x:Name="SitTitleBox" />
                        <TextBox x:Name="SitMessageBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" />
                        <TextBox x:Name="SitConfirmBox" />
                        <TextBox x:Name="SitSnoozeBox" />

                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                            <Button x:Name="PreviewStandButton" Click="OnPreviewStandClick" />
                            <Button x:Name="PreviewSitButton" Click="OnPreviewSitClick" />
                            <Button x:Name="ResetTextButton" Click="OnResetTextClick" />
                        </StackPanel>
                    </StackPanel>
                </Expander>

                <TextBlock
                    x:Name="NoteText"
                    TextWrapping="Wrap"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                <Button x:Name="ExitButton" Click="OnExitClick" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
